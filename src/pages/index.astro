---
const homeResponse = await fetch(
  "https://n7of-n2o.se.vkube.cloud/wp-json/wp/v2/pages?slug=home&_embed"
);

const pages = homeResponse.ok ? await homeResponse.json() : [];
const homePage = pages[0] ?? {};
const company = homePage.acf ?? {};

const companyName = company.foretagsnamn || "Vår verksamhet";
const heroEyebrow = company.hero_eyebrow || "Digitalt förtroende";
const companyTagline = company.slogan || "Vi bygger moderna webbplatser som faktiskt fungerar.";
const heroLead =
  company.hero_lead ||
  "Vi hjälper företag att presentera sig tydligt online, skapa bättre kundupplevelser och publicera innehåll på ett enkelt och skalbart sätt.";
const ideaTitle = company.var_ide_titel || "Vår idé";
const ideaText = company.var_ide || "En modern webbplats behöver inte vara svår att uppdatera.";
const workTitle = company.hur_vi_arbetar_titel || "Hur vi arbetar";
const workText = company.hur_vi_arbetar || "Vi använder moderna verktyg för att separera innehåll från presentation.";
const contactTitle = company.kontakt_titel || "Kontakta oss";
const companyEmail = company["e-post"] || "info@foretaget.se";
const companyPhone = company.telefon || "070-123 45 67";
const companyAddress = company.adress || "Stravägen 13";
const companyPostal = company.postnummer || "924 32";
const companyCity = company.ort || "Stockholm";
const companyHours = company.oppettider || "Mån-fre 08:00–17:00";
const ctaText = company["cta-text"] || "Läs vår blogg";
const ctaLink = company["cta-lank"] || "http://localhost:4321/blog";

const heroMediaId = company["hero-bild"];
let heroImage = "";

if (typeof heroMediaId === "object" && heroMediaId?.url) {
  heroImage = heroMediaId.url;
} else if (heroMediaId) {
  const heroMediaResponse = await fetch(
    `https://n7of-n2o.se.vkube.cloud/wp-json/wp/v2/media/${heroMediaId}`
  );

  if (heroMediaResponse.ok) {
    const heroMedia = await heroMediaResponse.json();
    heroImage = heroMedia.source_url || heroMedia.guid?.rendered || "";
  }
}
---

<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <title>{companyName}</title>
    <style>
      :root {
        --bg: #f3f4f6;
        --panel: rgba(255, 255, 255, 0.85);
        --card: #ffffff;
        --text: #111827;
        --muted: #4b5563;
        --line: #e5e7eb;
        --accent: #7c3aed;
        --accent-strong: #5b21b6;
        --soft: #f5f3ff;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background:
          radial-gradient(circle at top left, rgba(124, 58, 237, 0.08), transparent 30%),
          linear-gradient(180deg, #f7f7fb 0%, var(--bg) 100%);
        color: var(--text);
      }

      a {
        color: inherit;
      }

      .container {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .hero .container {
        max-width: 100%;
        padding: 0;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 20;
        backdrop-filter: blur(10px);
        background: rgba(255, 255, 255, 0.7);
        border-bottom: 1px solid rgba(229, 231, 235, 0.9);
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 78px;
      }

      .brand {
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: -0.03em;
      }

      nav {
        display: flex;
        gap: 1.4rem;
        align-items: center;
      }

      nav a {
        text-decoration: none;
        color: var(--muted);
        font-weight: 700;
      }

      nav a:hover {
        color: var(--text);
      }

      .cta {
        display: inline-block;
        background: linear-gradient(135deg, var(--accent), var(--accent-strong));
        color: #fff;
        text-decoration: none;
        padding: 0.9rem 1.5rem;
        border-radius: 999px;
        font-weight: 700;
        box-shadow: 0 12px 28px rgba(124, 58, 237, 0.22);
      }

      .cta:hover {
        transform: translateY(-1px);
      }

      .hero {
        padding: 0 0 3.25rem;
      }

      .hero-banner {
        position: relative;
        min-height: 560px;
        background-size: cover;
        background-position: center;
        overflow: hidden;
        display: flex;
        align-items: center;
        box-shadow: 0 30px 60px rgba(17, 24, 39, 0.10);
      }

      .hero-banner::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(15, 23, 42, 0.78) 0%, rgba(15, 23, 42, 0.60) 34%, rgba(15, 23, 42, 0.18) 100%);
      }

      .hero-copy {
        position: relative;
        z-index: 1;
        max-width: 640px;
        width: min(100%, 640px);
        padding: 2.5rem 0 2.5rem 0;
        color: #fff;
        margin-left: clamp(1.5rem, 6vw, 7rem);
      }

      .eyebrow {
        display: inline-block;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: #d6c9ff;
        font-weight: 800;
        margin-bottom: 1rem;
      }

      h1 {
        margin: 0 0 1rem;
        font-size: clamp(2.8rem, 5vw, 5.3rem);
        line-height: 0.94;
        letter-spacing: -0.06em;
        font-weight: 900;
      }

      .lead {
        color: rgba(255, 255, 255, 0.9);
        font-size: 1.14rem;
        line-height: 1.7;
        max-width: 620px;
        margin: 0;
      }

      .hero-actions {
        display: flex;
        gap: 1rem;
        margin-top: 2rem;
        flex-wrap: wrap;
      }

      .cta,
      .secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 52px;
        padding: 0.9rem 1.5rem;
        border-radius: 999px;
        font-weight: 700;
        text-decoration: none;
        border: 1px solid transparent;
      }

      .cta {
        background: linear-gradient(135deg, var(--accent), var(--accent-strong));
        color: #fff;
        box-shadow: 0 12px 28px rgba(124, 58, 237, 0.22);
      }

      .secondary {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.24);
        color: #fff;
      }

      .section {
        padding: 1rem 0 4rem;
      }

      .info-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.5rem;
      }

      .info-box {
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid var(--line);
        border-radius: 22px;
        padding: 1.7rem 1.5rem;
        box-shadow: 0 14px 28px rgba(15, 23, 42, 0.04);
      }

      .info-box h3 {
        margin-top: 0;
        margin-bottom: 0.8rem;
        font-size: 1.35rem;
        letter-spacing: -0.03em;
      }

      .info-box p {
        margin: 0;
        line-height: 1.7;
        color: var(--muted);
      }

      .footer-block {
        padding: 0 0 2.5rem;
      }

      footer {
        background: linear-gradient(135deg, #0f172a 0%, #1f2937 100%);
        color: rgba(255,255,255,0.8);
        padding: 2rem 0;
      }

      .footer-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
      }

      @media (max-width: 820px) {
        .info-grid {
          grid-template-columns: 1fr;
        }

        .topbar {
          flex-direction: column;
          justify-content: center;
          gap: 0.75rem;
          padding: 1rem 0;
        }

        nav {
          flex-wrap: wrap;
          justify-content: center;
        }

        .hero {
          padding-top: 0;
        }

        .hero-banner {
          min-height: 420px;
        }

        .hero-copy {
          padding: 2rem 1.2rem 2.2rem;
          margin-left: 0;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="container topbar">
        <div class="brand">{companyName}</div>
        <nav>
          <a href="/">Hem</a>
          <a href="/blog">Blogg</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <div
            class="hero-banner"
            style={heroImage ? `background-image: linear-gradient(90deg, rgba(17, 24, 39, 0.8) 0%, rgba(17, 24, 39, 0.62) 36%, rgba(17, 24, 39, 0.2) 100%), url('${heroImage}');` : "background: linear-gradient(135deg, #111827, #4c1d95);"}
          >
            <div class="hero-copy">
              <span class="eyebrow">{heroEyebrow}</span>
              <h1>{companyTagline}</h1>
              <p class="lead">{heroLead}</p>

              <div class="hero-actions">
                <a class="cta" href={ctaLink}>{ctaText}</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="om-oss">
        <div class="container">
          <div class="info-grid">
            <article class="info-box">
              <h3>{ideaTitle}</h3>
              <p>{ideaText}</p>
            </article>

            <article class="info-box">
              <h3>{workTitle}</h3>
              <p>{workText}</p>
            </article>

            <article class="info-box">
              <h3>{contactTitle}</h3>
              <p>
                {companyEmail}<br />
                {companyPhone}<br />
                {companyAddress}, {companyPostal} {companyCity}<br />
                {companyHours}
              </p>
            </article>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <div>© 2026 {companyName}</div>
        <div>Kontakta oss · {companyEmail}</div>
      </div>
    </footer>
  </body>
</html>
