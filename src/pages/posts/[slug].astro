---
export async function getStaticPaths() {
  const response = await fetch(
    "https://n7of-n2o.se.vkube.cloud/wp-json/wp/v2/posts?_embed"
  );

  const posts = response.ok ? await response.json() : [];

  return (Array.isArray(posts) ? posts : []).map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;

const response = await fetch(
  `https://n7of-n2o.se.vkube.cloud/wp-json/wp/v2/posts?_embed&slug=${slug}`
);

const post = response.ok ? await response.json() : null;
const currentPost = Array.isArray(post) ? post[0] : null;
const sanitizedContent = currentPost?.content?.rendered
  ? currentPost.content.rendered
      .replace(/\s(width|height|srcset|sizes)="[^"]*"/gi, "")
      .replace(/\sstyle="[^"]*"/gi, "")
  : "";
---

<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <title>{currentPost ? currentPost.title.rendered : "Inlägg"}</title>

    <style>
      body {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
        font-family: Arial, sans-serif;
        background: #f5f7fb;
        color: #1f2937;
      }

      .back-link {
        display: inline-block;
        margin-bottom: 1.5rem;
        color: #2563eb;
        text-decoration: none;
        font-weight: 600;
      }

      .back-link:hover {
        text-decoration: underline;
      }

      .post {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        padding: 2rem;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
      }

      .featured-image {
        width: 100%;
        height: auto;
        border-radius: 12px;
        margin-bottom: 1.5rem;
      }

      h1 {
        margin: 0 0 1rem;
        font-size: clamp(2rem, 4vw, 3rem);
      }

      .meta {
        color: #6b7280;
        font-size: 0.9rem;
        margin-bottom: 1.5rem;
      }

      .post-content {
        font-size: 1.06rem;
        line-height: 1.8;
        color: #1f2937;
      }

      .post-content > *:first-child {
        margin-top: 0;
      }

      .post-content h1,
      .post-content h2,
      .post-content h3,
      .post-content h4,
      .post-content h5,
      .post-content h6 {
        margin: 1.75rem 0 0.75rem;
        line-height: 1.3;
      }

      .post-content p,
      .post-content ul,
      .post-content ol,
      .post-content blockquote,
      .post-content pre,
      .post-content table {
        margin: 0 0 1.25rem;
      }

      .post-content a {
        color: #2563eb;
        text-decoration: underline;
      }

      .post-content ul,
      .post-content ol {
        padding-left: 1.5rem;
      }

      .post-content :global(img),
      .post-content :global(iframe),
      .post-content :global(video) {
        max-width: 100%;
        height: auto;
        border-radius: 10px;
        margin: 1rem 0;
      }

      .post-content :global(figure),
      .post-content :global(.wp-block-image) {
        max-width: 100%;
        width: 100%;
        margin: 1.5rem 0;
      }

      .post-content :global(.wp-block-image) img,
      .post-content :global(figure) img {
        display: block;
        width: auto !important;
        max-width: 100% !important;
        height: auto;
      }

      .post-content figcaption {
        color: #6b7280;
        font-size: 0.9rem;
        margin-top: 0.5rem;
      }

      .post-content blockquote {
        border-left: 4px solid #d1d5db;
        padding-left: 1rem;
        color: #4b5563;
        font-style: italic;
      }
    </style>
  </head>

  <body>
    <a href="/" class="back-link">← Tillbaka till alla inlägg</a>

    {
      currentPost ? (
        <article class="post">
          {currentPost._embedded?.["wp:featuredmedia"]?.[0]?.source_url && (
            <img
              class="featured-image"
              src={currentPost._embedded["wp:featuredmedia"][0].source_url}
              alt={currentPost.title.rendered}
            />
          )}

          <h1>{currentPost.title.rendered}</h1>

          <div class="meta">
            {new Date(currentPost.date).toLocaleDateString("sv-SE", {
              day: "numeric",
              month: "long",
              year: "numeric",
            })}
          </div>

          <div class="post-content" set:html={sanitizedContent} />
        </article>
      ) : (
        <p>Inlägget hittades inte.</p>
      )
    }
  </body>
</html>
